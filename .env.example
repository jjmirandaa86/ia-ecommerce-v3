# Product MySQL — client DB config is in ia_ecommerce_db tables
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ia_ecommerce_db
DB_SSL=false

JWT_SECRET=fake-jwt-secret-replace-me-32chars-min
JWT_EXPIRES_IN=8h
JWT_EXPIRES_IN_REMEMBER=30d
AUTH_COOKIE_NAME=ia_ecommerce_session

CLIENT_DB_SECRET_KEY=fake-client-db-secret-key-32chars!

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000

LLM_BASE_URL=http://localhost:11434
LLM_GENERATE_URL=http://localhost:11434/api/generate
LLM_MODEL=qwen2.5:7b
