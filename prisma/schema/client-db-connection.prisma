model ClientDbConnection {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  clientCompanyId   BigInt   @unique @map("client_company_id") @db.UnsignedBigInt
  clientDbServerId  BigInt   @map("client_db_server_id") @db.UnsignedBigInt
  databaseName      String   @map("database_name") @db.VarChar(128)
  username          String   @db.VarChar(128)
  passwordEncrypted String   @map("password_encrypted") @db.Text
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  company ClientCompany  @relation(fields: [clientCompanyId], references: [id])
  server  ClientDbServer @relation(fields: [clientDbServerId], references: [id])

  @@index([clientDbServerId])
  @@map("client_db_connection")
}
