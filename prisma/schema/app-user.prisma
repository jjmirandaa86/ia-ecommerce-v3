model AppUser {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  clientCompanyId BigInt    @map("client_company_id") @db.UnsignedBigInt
  username        String    @db.VarChar(80)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(120)
  department      String?   @db.VarChar(120)
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  company         ClientCompany     @relation(fields: [clientCompanyId], references: [id])
  userRoles       UserRole[]
  conversations   Conversation[]
  auditLogs       AiQueryAuditLog[]
  queryStatsDaily QueryStatsDaily[]

  @@unique([clientCompanyId, username])
  @@map("app_user")
}
