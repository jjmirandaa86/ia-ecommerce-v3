model ClientCompany {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  systemTypeId BigInt   @map("system_type_id") @db.UnsignedBigInt
  name         String   @db.VarChar(150)
  hostKey      String   @unique @map("host_key") @db.VarChar(120)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  systemType      SystemType          @relation(fields: [systemTypeId], references: [id])
  users           AppUser[]
  connection      ClientDbConnection?
  conversations   Conversation[]
  auditLogs       AiQueryAuditLog[]
  queryStatsDaily QueryStatsDaily[]

  @@index([systemTypeId])
  @@map("client_company")
}
