model Message {
  id                BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  conversationId    BigInt      @map("conversation_id") @db.UnsignedBigInt
  role              MessageRole
  content           String      @db.Text
  aiQueryAuditLogId BigInt?     @unique @map("ai_query_audit_log_id") @db.UnsignedBigInt
  createdAt         DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  conversation Conversation     @relation(fields: [conversationId], references: [id])
  auditLog     AiQueryAuditLog? @relation(fields: [aiQueryAuditLogId], references: [id])

  @@index([conversationId, createdAt])
  @@map("message")
}

enum MessageRole {
  user
  assistant
}
