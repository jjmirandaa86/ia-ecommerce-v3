model SuggestionExample {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  systemTypeId BigInt   @map("system_type_id") @db.UnsignedBigInt
  topic        String   @db.VarChar(32)
  exampleText  String   @map("example_text") @db.VarChar(500)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  systemType SystemType @relation(fields: [systemTypeId], references: [id])

  @@index([systemTypeId, topic, isActive])
  @@map("suggestion_example")
}
